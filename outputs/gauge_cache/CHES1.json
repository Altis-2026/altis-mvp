if", "volume": "https://water.noaa.gov/resources/probabilistic/exceedance/CHES1.volume.prob.weekint.gif"}, "entperiod": {"stage": "https://water.noaa.gov/resources/probabilistic/exceedance/CHES1.SSTG.exceed.90day.gif", "flow": "https://water.noaa.gov/resources/probabilistic/exceedance/CHES1.QINE.exceed.90day.gif", "volume": "https://water.noaa.gov/resources/probabilistic/exceedance/CHES1.volume.exceed.90day.gif"}, "shortrange": "https://water.noaa.gov/resources/probabilistic/short_term/CHES1.shortrange.hefs.png"}, "hydrograph": {"default": "https://water.noaa.gov/resources/hydrographs/ches1_hg.png", "floodcat": "https://water.noaa.gov/resources/hydrographs/ches1_record.png"}, "photos": [{"id": "5114825468045693422", "type": "Feature", "geometry": {"type": "Point", "coordinates": [34.708333333333, -79.875]}, "properties": {"image": "https://water.noaa.gov/resources/photos/ches1/5114825468045693422.jpeg", "caption": "Looking upstream on the Great Pee Dee River from the U.S. Hwy. 1 bridge."}}]}, "dataAttribution": [{"abbrev": "USGS", "text": "02130000", "title": "Observations courtesy of U.S. Geological Survey", "url": "https://waterdata.usgs.gov/nwis/inventory/?site_no=02130000"}], "impactsLowWaters": [], "normalThreshold": {"value": 0, "units": "ft"}, "hydronotes": [{"statement": "River forecasts for this location take into account past precipitation and the precipitation amounts expected approximately 48 hours into the future from the forecast issuance time.", "effective": "0101", "expiration": "1231"}, {"statement": "Gauge reading affected by reservoir operations.", "effective": "0101", "expiration": "1231"}], "datums": {"vertical": {"value": [{"label": "North American Vertical Datum of 1988", "abbrev": "NAVD88", "description": "A fixed reference for elevations determined by geodetic leveling. The datum was derived from a general adjustment of the first-order terrestrial leveling nets of the United States, Canada, and Mexico. In the adjustment, only the height of the primary tidal bench mark, referenced to the International Great Lakes Datum of 1985 (IGLD 85) local mean sea level height value, at Father Point, Rimouski, Quebec, Canada was held fixed, thus providing minimum constraint. NAVD 88 and IGLD 85 are identical. However, NAVD 88 bench mark values are given in Helmert orthometric height units while IGLD 85 values are in dynamic heights. See International Great Lakes Datum of 1985, National Geodetic Vertical Datum of 1929, and geopotential difference. NAVD 88 should not be used as Mean Sea Level.", "value": 56.02}]}, "horizontal": {"value": []}, "notes": {"value": []}}, "inundation": {"enabled": false, "url": "", "zeroDatum": null, "downloads": null, "siteSpecificInfo": "", "dataAttribution": []}, "upstreamLid": "RCKN7", "downstreamLid": "BENS1", "inService": {"enabled": true, "message": ""}, "lowThreshold": {"units": "ft", "value": 0}, "forecastReliability": "Forecasts are issued routinely year-round.", "TruncateObs": "-1", "TruncateFcst": "7", "ObservedFloodCategory": "no_flooding", "ForecastFloodCategory": "no_flooding"}
e}, {"occurredTime": "2006-09-14T00:00:00Z", "stage": 7.87, "flow": 546, "preliminary": "O", "olddatum": false}, {"occurredTime": "2005-03-23T00:00:00Z", "stage": 4.6, "flow": 125, "preliminary": "O", "olddatum": false}, {"occurredTime": "2004-12-10T00:00:00Z", "stage": 8.23, "flow": 0, "preliminary": "O", "olddatum": false}, {"occurredTime": "2004-09-28T00:00:00Z", "stage": 11.51, "flow": 2290, "preliminary": "O", "olddatum": false}, {"occurredTime": "2003-09-23T00:00:00Z", "stage": 6.5, "flow": 330, "preliminary": "O", "olddatum": false}]}, "lowWaters": {"historic": []}, "impacts": [{"stage": 25, "statement": "Major flooding continues.  Ramah Creek, an upstream tributary to Clarke Creek, may be flooding Huntersville-Concord Rd."}, {"stage": 21, "statement": "Major Flood Stage.  Historic, catastrophic flooding of Clarke Creek is developing with disastrous impacts to property.  Extraordinary flooding exceeding 6 ft deep is overwhelming low-lying areas.  Basements and crawl spaces may be completely submerged.  First-floor building elevations may be experiencing ruinous flooding greater than 1 ft deep, including along Northchase Dr and Three Greens Dr.  Roadway inundation exceeding 3-4 ft may be stranding several homes and businesses, severely restricting travel."}, {"stage": 19, "statement": "Moderate flooding continues.  Clarke Creek may be approaching Harris Road. "}, {"stage": 18, "statement": "Moderate Flood Stage.  Extremely rare, damaging flooding is developing adjacent to Clarke Creek with considerable impacts to property and travel.  Significant flooding reaching 4-6 ft deep is ongoing for low-lying areas.  Secondary roads, outbuildings, crawl spaces, and/or basements may be experiencing flooding reaching 2-4 feet deep, including along Northchase Dr and Three Greens Dr.  Flooding less than 1 ft deep may begin for first-floor building elevations.  Some homes and businesses may be stranded."}, {"stage": 14, "statement": "Minor Flood Stage.  Common, deeper flooding of low-lying areas adjacent to Clarke Creek is developing with lesser impacts to vulnerable property.  More significant floodwaters are beginning to impact low-lying areas, with inundation approximately 2-4 ft deep.  Adjacent mobile home/RV parks, secondary roads, and outbuildings may be experiencing flooding up to 1-2 ft deep.  Flooding less than 1 ft deep may begin impacting basements and primary roads.  Significant flooding of Rocky River is likely."}, {"stage": 9, "statement": "Action/Advisory Stage. Common, nuisance flooding of low-lying areas adjacent to Clarke Creek is beginning. Nuisance to Minor flooding along Rocky River may be imminent.  Floodwaters are beginning to impact farmland, woodlands, nurseries, parks, athletic fields, golf courses, greenways, and boat-access areas with up to 2 feet of inundation.  Adjacent mobile home/RV parks and secondary roads may experience floodwater inundation of up to 1 foot."}]}, "images": {"probability": {"weekint": {"stage": "", "flow": "", "volume": ""}, "entperiod": {"stage": "", "flow": "", "volume": ""}, "shortrange": ""}, "hydrograph": {"default": "https://water.noaa.gov/resources/hydrographs/ckcn7_hg.png", "floodcat": "https://water.noaa.gov/resources/hydrographs/ckcn7_record.png"}, "photos": []}, "dataAttribution": [{"abbrev": "USGS", "text": "02124080", "title": "Observations courtesy of U.S. Geological Survey", "url": "https://waterdata.usgs.gov/nwis/inventory/?site_no=02124080"}], "impactsLowWaters": [], "normalThreshold": {"value": 0, "units": "ft"}, "hydronotes": [], "datums": {"vertical": {"value": [{"label": "North American Vertical Datum of 1988", "abbrev": "NAVD88", "description": "A fixed reference for elevations determined by geodetic leveling. The datum was derived from a general adjustment of the first-order terrestrial leveling nets of the United States, Canada, and Mexico. In the adjustment, only the height of the primary tidal bench mark, referenced to the International Great Lakes Datum of 1985 (IGLD 85) local mean sea level height value, at Father Point, Rimouski, Quebec, Canada was held fixed, thus providing minimum constraint. NAVD 88 and IGLD 85 are identical. However, NAVD 88 bench mark values are given in Helmert orthometric height units while IGLD 85 values are in dynamic heights. See International Great Lakes Datum of 1985, National Geodetic Vertical Datum of 1929, and geopotential difference. NAVD 88 should not be used as Mean Sea Level.", "value": 608.3}]}, "horizontal": {"value": []}, "notes": {"value": []}}, "inundation": {"enabled": false, "url": "", "zeroDatum": null, "downloads": null, "siteSpecificInfo": "", "dataAttribution": []}, "upstreamLid": "", "downstreamLid": "", "inService": {"enabled": true, "message": ""}, "lowThreshold": {"units": "ft", "value": 0}, "forecastReliability": "Forecasts are not available. Only observed stages are available for this point.", "TruncateObs": "-1", "TruncateFcst": "1", "ObservedFloodCategory": "no_flooding", "ForecastFloodCategory": "fcst_not_current"}
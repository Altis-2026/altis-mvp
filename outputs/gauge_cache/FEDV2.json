preliminary": "R", "olddatum": false}, {"occurredTime": "1937-04-26T00:00:00Z", "stage": 38.1, "flow": 0, "preliminary": "O", "olddatum": false}, {"occurredTime": "1936-03-18T00:00:00Z", "stage": 18.1, "flow": 0, "preliminary": "O", "olddatum": false}, {"occurredTime": "1929-10-23T00:00:00Z", "stage": 18.5, "flow": 0, "preliminary": "O", "olddatum": false}, {"occurredTime": "1924-10-01T00:00:00Z", "stage": 22.8, "flow": 0, "preliminary": "O", "olddatum": false}, {"occurredTime": "1924-05-13T00:00:00Z", "stage": 25.1, "flow": 0, "preliminary": "O", "olddatum": false}, {"occurredTime": "1918-04-10T00:00:00Z", "stage": 19.5, "flow": 0, "preliminary": "O", "olddatum": false}, {"occurredTime": "1901-05-23T00:00:00Z", "stage": 27.2, "flow": 0, "preliminary": "O", "olddatum": false}, {"occurredTime": "1889-06-01T00:00:00Z", "stage": 32.2, "flow": 0, "preliminary": "O", "olddatum": false}]}, "lowWaters": {"historic": []}, "impacts": [{"stage": 55.5, "statement": "Water reaches the higher bluffs in lower Fredericksburg, allowing it to move further inland. At least 70 city blocks are flooded, with significant inundation of buildings occurring. Hundreds of structures and dozens of roads are affected."}, {"stage": 44.5, "statement": "A significant flood is occurring in Fredericksburg. Almost all of Caroline Street is underwater, along with Sophia Street, and numerous cross streets between the two. At least 20 city blocks are flooded. Hundreds of buildings are affected in Fredericksburg, and several homes are flooded on the east side of the river. Further inland from the river, water is approaching Princess Anne Street in spots. Water also approaches the Route 3 bridge over the river."}, {"stage": 40.5, "statement": "Caroline Street in Fredericksburg is flooded between Amelia and Wolfe streets. All of Sophia Street is flooded. Dozens of buildings are flooded, including some homes."}, {"stage": 33.5, "statement": "Water completely covers Sophia Street between Wolfe Street and Amelia Street. Numerous buildings are flooded in this area. Water also begins to approach homes on the east side of the river, including near Tylerton."}, {"stage": 28.5, "statement": "Water reaches several buildings in the City of Fredericksburg, along with multiple parking lots. The Fredericksburg City Dock is under nearly 15 feet of water."}, {"stage": 24.5, "statement": "Half the municipal lot on Sophia Street is closed. The Executive Plaza lot off Sophia Street also floods. The intersection of Naomi Road and Dairy Lane begins to flood."}, {"stage": 22.5, "statement": "Water reaches the municipal lot on Sophia Street. Naomi Road is flooded."}, {"stage": 20.5, "statement": "Water reaches some parking lots near the river in the city of Fredericksburg. Two homes on Sophia Street are flooded."}, {"stage": 19.5, "statement": "A home on River Road on the Stafford County side of the river is flooded."}, {"stage": 17.5, "statement": "Old Mill Park in Fredericksburg can no longer be accessed by car due to flooding."}, {"stage": 16.5, "statement": "Water begins to reach River Road on the east side of the river. The Old Mill Park Maintenance Facility is flooded."}, {"stage": 15.5, "statement": "Water enters a basement at a home near Fredericksburg City Dock. Old Mill Park begins to flood and will be closed. Water enters a guest house off Caroline Street."}, {"stage": 12.5, "statement": "City Dock in Fredericksburg is closed. Access to the dock and boat ramp are affected due to flooding."}, {"stage": 10.5, "statement": "Water reaches the waterfront at Fredericksburg City Dock."}]}, "images": {"probability": {"weekint": {"stage": "https://water.noaa.gov/resources/probabilistic/exceedance/FEDV2.SSTG.prob.weekint.gif", "flow": "https://water.noaa.gov/resources/probabilistic/exceedance/FEDV2.QINE.prob.weekint.gif", "volume": "https://water.noaa.gov/resources/probabilistic/exceedance/FEDV2.volume.prob.weekint.gif"}, "entperiod": {"stage": "https://water.noaa.gov/resources/probabili
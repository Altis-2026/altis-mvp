, {"occurredTime": "2005-11-18T00:00:00Z", "stage": 0.25, "flow": -9999, "statement": "From USGS approved data online"}, {"occurredTime": "2004-11-09T00:00:00Z", "stage": 0.26, "flow": -9999, "statement": "From USGS approved data online"}, {"occurredTime": "2000-07-12T00:00:00Z", "stage": 0.35, "flow": -9999, "statement": "From USGS approved data online"}, {"occurredTime": "2006-06-05T00:00:00Z", "stage": 0.45, "flow": -9999, "statement": "From USGS approved data online"}, {"occurredTime": "2017-11-20T00:00:00Z", "stage": 0.48, "flow": -9999, "statement": "From USGS approved data online, also 23rd, may have been lower data missing 24-29"}, {"occurredTime": "2013-05-16T00:00:00Z", "stage": 0.51, "flow": -9999, "statement": "From USGS approved data online"}, {"occurredTime": "2016-08-15T00:00:00Z", "stage": 0.65, "flow": -9999, "statement": "From USGS approved data online"}, {"occurredTime": "2003-01-16T00:00:00Z", "stage": 0.68, "flow": -9999, "statement": "From USGS approved data online"}, {"occurredTime": "2018-01-10T00:00:00Z", "stage": 0.69, "flow": -9999, "statement": "From USGS approved data online"}, {"occurredTime": "1999-08-17T00:00:00Z", "stage": 0.76, "flow": -9999, "statement": "From USGS approved data online"}, {"occurredTime": "2019-05-25T00:00:00Z", "stage": 0.78, "flow": -9999, "statement": "From USGS approved data online"}, {"occurredTime": "2015-07-12T00:00:00Z", "stage": 0.79, "flow": -9999, "statement": "From USGS approved data online"}]}, "impacts": [{"stage": 26, "statement": "Extensive flooding in River Bend,River Birch Alligator Lake,Holly Shelter Estates,and Sandy Bend subdivisions and along the length of the river including tributaries. Impassable roads include Croomsbridge RD,Old Maple Hill RD,River RD near Wallace,Turtle Hill TR,Hickory Hill LN,White Tail LN,Mallard Roost DR,Oxbow,Shaw Hwy,White Stocking RD,Hwy 53,Stag Park RD,Hwy 210,Hwy 117 near Castle Hayne,Interstate 40,and Island Creek RD. Old River RD in Morgan Cove will flood. Homes in all of these areas may flood."}, {"stage": 25, "statement": "Extensive flooding in River Bend,River Birch Alligator Lake,Holly Shelter Estates,and Sandy Bend subdivisions and along the length of the river including tributaries. Impassable roads include Croomsbridge RD,Old Maple Hill RD,River RD near Wallace,Turtle Hill TR,Hickory Hill LN,White Tail LN,Mallard Roost DR,Oxbow,Shaw Hwy,White Stocking RD,Hwy 53,Stag Park RD,Hwy 210,Hwy 117 near Castle Hayne,Interstate 40,and Island Creek RD. Old River RD in Morgan Cove will flood. Homes in all of these areas may flood."}, {"stage": 24, "statement": "Extensive flooding in River Bend, River Birch, Alligator Lake, Holly Shelter Estates, and Sandy Bend subdivisions and along the length of the river including tributaries. Flooded roads include Croomsbridge RD,Old Maple Hill RD,River RD near Wallace,Turtle Hill TR,Hickory Hill LN,White Tail LN,Mallard Roost DR,Oxbow,Shaw Hwy,White Stocking RD,Hwy 53,Stag Park RD,Hwy 210,Hwy 117 near Castle Hayne,Interstate 40,and Island Creek RD. Old River RD in Morgan Cove will flood. Homes in all of these areas will flood."}, {"stage": 23, "statement": "Extensive flooding in River Bend,River Birch,Alligator Lake,Holly Shelter Estates,and Sandy Bend subdivisions and along the length of the river including tributaries. Flooded roads include Croomsbridge RD,Old Maple Hill RD,River RD near Wallace,Turtle Hill TR,Hickory Hill LN,White Tail LN,Mallard Roost DR,Oxbow,Shaw Hwy,White Stocking RD,Hwy 53,Stag Park RD,Hwy 210,Hwy 117 near Castle Hayne,Interstate 40,and Island Creek RD. Old River Road in Morgan Cove will flood. Homes in these areas may flood."}, {"stage": 22, "statement": "Extensive flooding in River Bend,River Birch,Alligator Lake,Holly Shelter Estates,and Sandy Bend subdivisions and along the length of the river including tributaries. Flooded roads include Croomsbridge RD,Old Maple Hill RD,River RD near Wallace,Turtle Hill TR,Hickory Hill LN,White Tail LN,Mallard Roost DR,Oxbow,Shaw Hwy,White Stocking RD,Hwy 53,Stag Park RD,Hwy 210,and Island Creek RD. Homes in these areas may flood. Low areas along Old River RD in Morgan Cove and Hwy 117 near Castle Hayne will flood."}, {"stage": 21, "statement": "Extensive flooding in River Bend,River Birch,Alligator Lake,Holly Shelter Estates,and Sandy Bend subdivisions and along the length of the river and tributaries. Flooded roads include Croomsbridge RD,Old Maple Hill RD,River RD near Wallace,Turtle Hill TR,Hickory Hill LN,White Tail LN,Mallard Roost DR,Oxbow,Shaw Hwy,White Stocking RD,HWY 53,Stag Park RD,Hwy 210,and Island Creek RD. Homes in these areas may flood. Low areas along Old River RD in Morgan Cove begin to flood. Hwy 117 near Castle Hayne will flood."}, {"stage": 20, "statement": "Extensive flooding in River Bend,River Birch,Alligator Lake,Holly Shelter Estates,and Sandy Bend subdivisions and along the length of the river and tributaries. Flooded roads include Croomsbridge RD,Old Maple Hill RD,River RD near Wallace,Turtle Hill TR,Hickory Hill LN,White Tail LN,Mallard Roost DR,Oxbow,Shaw Hwy,White Stocking RD,HWY 53,Stag Park RD,Hwy 210,and Island Creek RD. Homes in these areas may flood. Hwy 117 near Castle Hayne and low areas along Old River RD in Morgan Cove may begin to flood."}, {"stage": 19, "statement": "Extensive flooding of River Bend,River Birch,Alligator Lake,Holly Shelter Estates,and Sandy Bend and on Croomsbridge RD and Old Maple Hill RD. The ends of River RD near Wallace,Turtle Hill TR,Hickory Hill LN,White Tail LN,Mallard Roost DR,and Oxbow Landing are cutoff by floodwaters. Shaw Hwy ,Whitestocking RD,Hwy 53,Hwy 210 near Lanes Ferry,Stage Park Rd,and Island Creek Rd near Island Creek are impassable. Equine Acres Country Estates flooding worsens. Water may get into homes in some of these areas."}, {"stage": 18, "statement": "Extensive flooding of River Bend, River Birch, Alligator Lake, Holly Shelter Estates, and Sandy Bend and Croomsbridge RD and Old Maple Hill RD. The ends of River RD near Wallace, Turtle Hill TR, Hickory Hill LN, White Tail LN, Mallard Roost DR, and Oxbow Landing are cutoff by flooding. Shaw Hwy, White Stocking RD, and Hwy 53 are impassable.  Homes may flood in these areas. Hwy 210 at Lanes Ferry, Stag Park Road, and Island Creek Road at Island Creek will flood. Equine Acres Country Estates flooding worsens."}, {"stage": 17, "statement": "Flooding deepens in River Bend,River Birch,Alligator Lake,Holly Shelter Estates,and Sandy Bend. The ends of Turtle Hill TR,Hickory Hill LN,White Tail LN,Mallard Roost DR,and Oxbow Landing will be cutoff by flooding. Croomsbridge RD,Old Maple Hill RD.Shaw Hwy,White Stocking RD,and Hwy 53 are impassable in multiple locations. Water may get into some homes. Hwy 210 at Lanes Ferry,Stag Park RD at Cypress and Burgaw Creeks,and Island Creek at Island Creek will flood. Equine Landing Rd and Mustang Pt are flooded."}, {"stage": 16, "statement": "Flooding worsens in River Bend, River Birch, Alligator Lake, Holly Shelter Estates, and Sandy Bend and on Croomsbridge RD and Old Maple Hill RD.  The ends of Turtle Hill TR, Hickory Hill LN, White Tail LN, Mallard Roost DR, and Oxbow Landing may be cutoff by floodwaters.  Shaw Hwy, White Stocking RD, and Island Creek RD at Island Creek are flooded. Hwy 53 will be impassable. Hwy 210 at Lanes Ferry and Stag Park RD at Cypress and Burgaw Creeks may begin to flood. Equine Landing Rd and Mustang Pt may flood."}, {"stage": 15, "statement": "Flooding deepens in the River Bend,River Birch,Alligator Lake,Holly Shelter Estates,and Sandy Bend subdivisions and on Croomsbridge RD and Old Maple Hill RD. The ends of Turtle Hill TR,Hickory Hill LN,White Tail LN,Mallard Roost DR,and Oxbow Landing may be cutoff by floodwaters. Shaw Hwy between Carl Meeks RD and Lillington Ln and White Stocking RD from Chorley RD to Mack Williams Ln are flooded. Island Creek RD may flood at Island Creek. Hwy 53 may be impassable. Equine Acres Country Estates may flood."}, {"stage": 14, "statement": "Flooding deepens in the River Bend,River Birch,Alligator Lake,Holly Shelter Estates,and Sandy Bend subdivisions. Croomsbridge RD and Old Maple Hill RD will be impassable in multiple locations. Flooding worsens near the ends of Turtle Hill TR,Hickory Hill LN,White Tail LN,Mallard Roost DR,and Oxbow Landing. Shaw Hwy is flooded between Carl Meeks Road and Lillington Lane. White Stocking RD is flooded from Chorley RD to Mack Williams Ln. Flooding worsens on Hwy 53. Island Creek RD may flood at Island Creek."}, {"stage": 13, "statement": "Flooding deepens in the River Bend, River Birch and Alligator Lake subdivisions. Croomsbridge RD and Old Maple Hill RD will be impassable in multiple locations.  Flooding in Holly Shelter Estates and in Sandy Bend worsens.  Flooding also worsens near the ends of Turtle Hill TR, Hickory Hill LN, White Tail LN, Mallard Roost DR, and Oxbow Landing.  Shaw Highway is flooded at Ashes Creek and Lillington Creek."}, {"stage": 12, "statement": "Flooding worsens in the River Bend, River Birch and Alligator Lake subdivisions. Flooding on Croomsbridge RD and Old Maple Hill RD worsens and the roads may be impassable in multiple locations.  Holly Shelter Estates begins to flood and flooding in Sandy Bend worsens.  Flooding worsens near the ends of Turtle Hill TR, Hickory Hill LN, White Tail LN, Mallard Roost DR, and Oxbow Landing.  Shaw Hwy is flooded at Ashes and Lillington Creeks. Equine Landing RD area may flood."}, {"stage": 11, "statement": "Flooding worsens in River Bend and River Birch areas with some roads being impassable. More of Croomsbridge RD floods and the road is impassable west of the bridge over the river. Minor flooding begins near the ends of White Tail LN, Mallard Roost DR, and Oxbow Landing. Flooding worsens near the ends of Turtle Hill TR and Hickory Hill LN. Flooding begins in Alligator Lakes and on Old Maple Hill RD near Shaken Creek. Shaw Hwy begins to flood at Ashes and Lillington Creeks. Flooding may begin in Sandy Bend."}, {"stage": 10, "statement": "Minor flooding of roads in the River Bend and River Birch subdivisions. Flooding of Croomsbridge Road begins west of the bridge over the river. Minor flooding may begin in areas along Mallard Roost Drive nearer the river and near the ends of Turtle Hill Trail and Hickory Hill Lane."}, {"stage": 9, "statement": "Water deepens on the lowest portions of River Bend Road and River Birch Road."}, {"stage": 8, "statement": "Water affects the lowest portions of River Bend Road and River Birch Road."}]}, "images": {"probability": {"weekint": {"stage": "https://water.noaa.gov/resources/probabilistic/exceedance/BGWN7.SSTG.prob.weekint.gif", "flow": "https://water.noaa.gov/resources/probabilistic/exceedance/BGWN7.QINE.prob.weekint.gif", "volume": "https://water.noaa.gov/resources/probabilistic/exceedance/BGWN7.volume.prob.weekint.gif"}, "entperiod": {"stage": "https://water.noaa.gov/resources/probabilistic/exceedance/BGWN7.SSTG.exceed.90day.gif", "flow": "https://water.noaa.gov/resources/probabilistic/exceedance/BGWN7.QINE.exceed.90day.gif", "volume": "https://water.noaa.gov/resources/probabilistic/exceedance/BGWN7.volume.exceed.90day.gif"}, "shortrange": "https://water.noaa.gov/resources/probabilistic/short_term/BGWN7.shortrange.hefs.png"}, "hydrograph": {"default": "https://water.noaa.gov/resources/hydrographs/bgwn7_hg.png", "floodcat": "https://water.noaa.gov/resources/hydrographs/bgwn7_record.png"}, "photos": []}, "dataAttribution": [{"abbrev": "US Geological Survey", "text": "USGS--Water Resources of the United States", "title": "US Geological Survey", "url": "https://waterdata.usgs.gov/nwis"}, {"abbrev": "USGS", "text": "02108566", "title": "Observations courtesy of U.S. Geological Survey", "url": "https://waterdata.usgs.gov/nwis/inventory/?site_no=02108566"}], "impactsLowWaters": [], "normalThreshold": null, "hydronotes": [{"statement": "River forecasts for this location take into account past precipitation and the precipitat